{
  "name": "tailr-backend",
  "version": "1.0.50",
  "scripts": {
    "test": "bun test",
    "start": "bun run src/index.ts",
    "dev": "bun run --env-file .env --watch src/index.ts",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "scan": "bun pm scan",
    "db:migrate": "bun run scripts/migrate.ts",
    "seed:cedar-gate": "bun run --env-file .env scripts/seed-cedar-gate.ts"
  },
  "dependencies": {
    "@elysiajs/cors": "^1.4.2",
    "@elysiajs/jwt": "^1.4.2",
    "@elysiajs/swagger": "^1.3.1",
    "@google/genai": "^2.24.0",
    "@upstash/redis": "^1.39.0",
    "drizzle-orm": "^0.45.3",
    "elysia": "1.4.30",
    "postgres": "^3.4.9",
    "resend": "^6.34.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@socketsecurity/bun-security-scanner": "^1.1.3",
    "bun-types": "1.4.2",
    "drizzle-kit": "^0.31.11",
    "typescript": "^5.8.2"
  },
  "module": "src/index.js"
}
