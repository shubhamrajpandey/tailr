# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tailr

# Authentication & Cryptographic Secrets
# Generate secure secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production_32chars!
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_32chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30

# CORS & Client URLs
FRONTEND_URL=http://localhost:3000

# Resend Transactional Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Tailr Security <noreply@tailr.shubhamrajpandey.com.np>

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Google Gemini AI (Free-Tier API Key)
GEMINI_API_KEY=your_gemini_api_key_here

