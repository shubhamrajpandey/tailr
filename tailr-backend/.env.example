# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tailr

# Authentication & Cryptographic Secrets
# Generate secure secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production_32chars!
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_32chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30

# CORS & Client URLs
FRONTEND_URL=http://localhost:3000

# Optional SMTP Settings for Production Mailer (Defaults to Console in Dev)
# SMTP_HOST=smtp.mailgun.org
# SMTP_PORT=587
# SMTP_USER=postmaster@yourdomain.com
# SMTP_PASS=your_smtp_password
# SMTP_FROM=Tailr Security <noreply@tailr.io>
