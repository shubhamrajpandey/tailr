# Server Configuration
PORT=3001
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/tailr

# Authentication & Cryptographic Secrets
# Generate secure secrets: openssl rand -base64 32
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production_32chars!
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_32chars!
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# OTP Configuration
OTP_EXPIRY_MINUTES=10
OTP_RESEND_COOLDOWN_SECONDS=30

# CORS & Client URLs
FRONTEND_URL=http://localhost:3000

# Resend Transactional Email Configuration
RESEND_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=Tailr Security <noreply@tailr.example.com>

# Reverse Proxy Trust Configuration ('true', 'false', or 'cloudflare')
TRUST_PROXY=false

# Google OAuth 2.0 Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# AI Model Provider Credentials (At least one required for AI tailoring)
GEMINI_API_KEY=your_gemini_api_key_here
GROQ_API_KEY=your_groq_api_key_here

# Distributed State & Rate Limiting (Upstash Redis - optional; falls back to in-memory)
UPSTASH_REDIS_REST_URL=https://your-database-id.upstash.io
UPSTASH_REDIS_REST_TOKEN=your_upstash_redis_token_here

# Cross-Subdomain Cookie Configuration (optional, e.g. .tailr.io)
# COOKIE_DOMAIN=.tailr.io

# Additional CORS Allowed Origins (comma-separated list of extra origins)
# CORS_ALLOWED_ORIGINS=https://app.tailr.io,https://staging.tailr.io

# OpenAPI Swagger Documentation Toggle in Production ('true' or 'false')
# ENABLE_SWAGGER=false


