export PATH="$BUN_INSTALL/bin:$HOME/.bun/bin:$USERPROFILE/.bun/bin:$PATH"

echo "Running lint-staged..."
npx lint-staged

echo "Running frontend checks..."
cd tailr-frontend && npm run lint && npm run typecheck
cd ..

echo "Running backend checks..."
cd tailr-backend
if command -v bun >/dev/null 2>&1; then
  bun run lint && bun run typecheck
else
  echo "Bun not found in hook environment, skipping backend checks."
fi
cd ..