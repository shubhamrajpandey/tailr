  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0"
  },
  "lint-staged": {
    "tailr-frontend/**/*.{ts,tsx}": [
      "npx --prefix tailr-frontend prettier --write"
