# URL pointing to the public Elysia backend API (browser-facing)
NEXT_PUBLIC_API_URL=http://localhost:3001

# Internal server-to-server backend URL (optional, for Docker networks / Kubernetes SSR)
# INTERNAL_BACKEND_URL=http://backend:3001

# Public canonical application URL (used for sitemap and metadata)
# NEXT_PUBLIC_APP_URL=https://app.tailr.ai

# Public project support configuration (optional)
NEXT_PUBLIC_SUPPORT_EMAIL=support@tailr.io
# NEXT_PUBLIC_SUPPORT_PHONE=+1234567890

# Observability and Performance (optional)
# NEXT_PUBLIC_VERCEL_ANALYTICS_ENABLED=false
# NEXT_PUBLIC_SENTRY_DSN=https://your_sentry_dsn@o0.ingest.sentry.io/0

